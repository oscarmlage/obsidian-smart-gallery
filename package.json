{
    "name": "smart-gallery",
    "version": "1.8.1",
    "description": "Main Gallery to tag, filter, and add notes to images. Display blocks to embed images inside notes. Display block to an image information",
    "author": "Óscar M. Lage",
    "main": "main.js",
    "license": "MIT",
    "scripts": {
        "svelte-check": "svelte-check",
        "lint": "svelte-check",
        "lint:eslint": "eslint . --max-warnings 0",
        "lint:all": "npm run lint && npm run lint:eslint",
        "build": "npm run lint && rollup -c",
        "dev": "rollup --config rollup.config.mjs -w",
        "rel": "release.sh",
        "pub": "publish.sh"
    },
    "dependencies": {
        "canvas": "latest",
        "extract-colors": "latest",
        "obsidian": "latest",
        "svelte": "^4.2.0",
        "svelte-grid": "^5.1.2",
        "ts-exif-parser": "latest",
        "tslib": "latest"
    },
    "devDependencies": {
        "@eslint/js": "^9.30.1",
        "@rollup/plugin-commonjs": "25.0.4",
        "@rollup/plugin-node-resolve": "15.2.1",
        "@rollup/plugin-typescript": "11.1.3",
        "@testing-library/jest-dom": "6.1.2",
        "@testing-library/svelte": "4.0.3",
        "@tsconfig/svelte": "5.0.2",
        "@types/jest": "29.5.4",
        "@types/node": "20.5.6",
        "@typescript-eslint/utils": "^8.35.1",
        "esbuild-svelte": "^0.7.4",
        "eslint": "^9.30.1",
        "eslint-plugin-obsidianmd": "^0.1.9",
        "globals": "^14.0.0",
        "jest": "29.6.4",
        "jiti": "^2.6.1",
        "rollup": "^3.29.5",
        "rollup-plugin-copy": "latest",
        "rollup-plugin-svelte": "7.1.6",
        "svelte": "^4.2.0",
        "svelte-check": "^3.5.0",
        "svelte-jester": "3.0.0",
        "svelte-preprocess": "^5.0.4",
        "ts-jest": "29.1.1",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.35.1"
    },
    "jest": {
        "moduleNameMapper": {
            "src/(.*)": "<rootDir>/src/$1"
        },
        "transform": {
            "^.+\\.svelte$": [
                "svelte-jester",
                {
                    "preprocess": true
                }
            ],
            "^.+\\.ts$": "ts-jest"
        },
        "moduleFileExtensions": [
            "js",
            "ts",
            "svelte"
        ]
    }
}
